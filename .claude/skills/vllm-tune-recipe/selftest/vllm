#!/usr/bin/env python3
"""Stand-in for the `vllm` CLI so selftest.sh can exercise runner.py and
analyze.py without a GPU. Behaviour is keyed off the serve argv:

  --moe-backend BROKEN    server exits during startup
  --kv-cache-dtype fp8    half the probe answers are wrong (accuracy gate)
  --max-num-seqs 32       +20% throughput (a real win)
  --max-num-seqs 64       +30% throughput but +15% E2E latency (latency guard)
  --max-num-seqs 48       +25% throughput, +50% TPOT, -20% E2E (queue removed: a win)
  --linear-backend b12x   +1% throughput (inside the noise floor)
  --reasoning-parser      answer arrives in `reasoning`, `content` is null
  --speculative-config    /metrics exposes spec counters; each scrape adds
                          100 drafts / 400 draft tokens / 220 accepted (55%)
  --profiler-config       /stop_profile writes a gzipped trace with two kernels
  an *FP8* model          -10% throughput at concurrency > 1, +50% at 1 (mixed win)
  FAKE_SLOW_INIT (env)    logs a 700 s engine init (slow-start warning)
Startup logs "Using ... backend" lines the way vLLM does (MARLIN for NVFP4
models, FLASHINFER_TRTLLM for FP8 ones).
"""

import gzip
import json
import os
import re
import signal
import sys
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def arg(argv, name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default


def serve(argv):
    model, port = argv[2], int(arg(argv, "--port", 8000))
    if arg(argv, "--moe-backend") == "BROKEN":
        print("ValueError: unknown MoE backend BROKEN", flush=True)
        sys.exit(1)
    wrong = arg(argv, "--kv-cache-dtype") == "fp8"
    speed, tpot, e2el = 1.0, 1.0, None  # e2el None: scales with speed
    if arg(argv, "--max-num-seqs") == "32":
        speed *= 1.2
    if arg(argv, "--max-num-seqs") == "48":
        speed, tpot, e2el = 1.25, 1.5, 0.8
    if arg(argv, "--max-num-seqs") == "64":
        speed, tpot, e2el = 1.3, 1.5, 1.15
    reasoning = "--reasoning-parser" in argv
    fp8 = "FP8" in model
    c1 = 1.0
    if fp8:
        speed, c1 = 0.9, 1.5 / 0.9
    if arg(argv, "--linear-backend") == "b12x":
        speed *= 1.01
    spec = "--speculative-config" in argv
    prof = json.loads(arg(argv, "--profiler-config", "null"))
    state = {"n": 0, "scrapes": 0}

    def metrics():
        # Prometheus text as vLLM exports it: _total counters, _created
        # companions, per-engine labels, per-position counters.
        k = state["scrapes"] = state["scrapes"] + 1
        lines = []
        for name, per in (("num_drafts", 100), ("num_draft_tokens", 400), ("num_accepted_tokens", 220)):
            lines += [f'vllm:spec_decode_{name}_total{{engine="0",model_name="m"}} {per * k}.0',
                      f'vllm:spec_decode_{name}_created{{engine="0",model_name="m"}} 1.7e9']
        for pos, per in enumerate((80, 60, 50, 30)):
            lines.append(f'vllm:spec_decode_num_accepted_tokens_per_pos_total{{engine="0",position="{pos}"}} {per * k}.0')
        return "\n".join(lines) + "\n"

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, obj):
            body = json.dumps(obj).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/health":
                self.reply({})
            elif self.path == "/v1/models":
                self.reply({"data": [{"id": model}]})
            elif self.path == "/metrics":
                body = (metrics() if spec else "# no spec decoding\n").encode()
                self.send_response(200)
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif self.path == "/fake_speed":
                self.reply({"speed": speed, "tpot": tpot, "e2el": e2el or 1 / speed, "c1": c1})
            else:
                self.send_error(404)

        def do_POST(self):
            if self.path in ("/start_profile", "/stop_profile"):
                if self.path == "/stop_profile" and prof:
                    os.makedirs(prof["torch_profiler_dir"], exist_ok=True)
                    events = [{"cat": "kernel", "name": "fused_moe_kernel", "dur": 3000},
                              {"cat": "kernel", "name": "flash_attn_fwd", "dur": 1000},
                              {"cat": "cpu_op", "name": "aten::mm", "dur": 9999}]
                    with gzip.open(f"{prof['torch_profiler_dir']}/rank0.pt.trace.json.gz", "wt") as f:
                        json.dump({"traceEvents": events}, f)
                self.send_response(200)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            req = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
            a, b, c = map(int, re.findall(r"\d+", req["messages"][0]["content"])[:3])
            state["n"] += 1
            ans = a * b + c + (1 if wrong and state["n"] % 2 else 0)
            text = f"The answer is {ans}"
            msg = {"content": None, "reasoning": text} if reasoning else {"content": text}
            self.reply({"choices": [{"message": msg, "finish_reason": "stop"}]})

    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    moe = "FLASHINFER_TRTLLM Fp8" if fp8 else "'MARLIN' NvFp4"
    print(f"(EngineCore pid=1) INFO [nvfp4.py:304] Using {moe} MoE backend out of potential backends: ['A', 'B']", flush=True)
    print("(EngineCore pid=1) INFO [monitor.py:81] Initial profiling/warmup run took 3.20 s", flush=True)
    init = 700.0 if os.environ.get("FAKE_SLOW_INIT") else 12.0
    print(f"(EngineCore pid=1) INFO [core.py:361] init engine (profile, create kv cache, warmup model) took {init:.2f} s", flush=True)
    time.sleep(1)
    print(f"serving {model} on {port}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


def bench(argv):
    port = arg(argv, "--port")
    fake = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/fake_speed"))
    speed, tpot, e2el = fake["speed"], fake["tpot"], fake["e2el"]
    if arg(argv, "--max-concurrency") == "1":
        speed, e2el = speed * fake["c1"], e2el / fake["c1"]
    if arg(argv, "--dataset-name") == "spec_bench":
        with open(arg(argv, "--dataset-path")) as f:
            assert "turns" in f.readline()
    n = int(arg(argv, "--num-prompts"))
    out = {
        "completed": n, "failed": 0, "duration": 10.0,
        "request_throughput": n / 10 * speed,
        "output_throughput": 1000 * speed,
        "total_token_throughput": 3000 * speed,
        "median_ttft_ms": 100 / speed, "p99_ttft_ms": 300 / speed,
        "median_tpot_ms": 10 / speed * tpot, "p99_tpot_ms": 20 / speed * tpot,
        "median_itl_ms": 10 / speed, "p99_itl_ms": 20 / speed,
        "median_e2el_ms": 2000 * e2el,
    }
    path = f"{arg(argv, '--result-dir')}/{arg(argv, '--result-filename')}"
    with open(path, "w") as f:
        json.dump(out, f)


def main():
    argv = sys.argv
    if argv[1:2] == ["--version"]:
        print("0.29.0")
    elif argv[1:2] == ["serve"]:
        serve(argv)
    elif argv[1:3] == ["bench", "serve"]:
        bench(argv)
    else:
        sys.exit(f"fake vllm: unsupported {argv[1:]}")


if __name__ == "__main__":
    main()
